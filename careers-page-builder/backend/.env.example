# Database Connection (Neon PostgreSQL or SQLite for local dev)
# Neon example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./careers.db

# Security & JWT
JWT_SECRET=production-grade-super-secret-key-replace-in-real-deployment-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS / Client configuration
FRONTEND_URL=http://localhost:5173
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
